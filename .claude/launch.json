{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "aquatrack.api.main:app",
        "--reload",
        "--reload-dir",
        "src",
        "--env-file",
        ".env"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "firebase-emulators",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "emulators"
      ],
      "port": 4000
    },
    {
      "name": "backend-emulated",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099",
        "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080",
        "STORAGE_EMULATOR_HOST=http://127.0.0.1:9199",
        "FIREBASE_PROJECT_ID=demo-aquatrack",
        "AQUATRACK_POSE_SOURCE=precomputed",
        "AQUATRACK_PRECOMPUTED_POSE_DIR=data/precomputed_pose",
        "AQUATRACK_MAX_ATTEMPTS=10",
        "uv",
        "run",
        "uvicorn",
        "aquatrack.api.main:app",
        "--reload",
        "--reload-dir",
        "src"
      ],
      "port": 8000
    },
    {
      "name": "frontend-emulated",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_FIREBASE_EMULATORS=true",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "firebase-emulators-restricted",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "emulators",
        "--",
        "--restricted"
      ],
      "port": 4000
    },
    {
      "name": "backend-demo-rehearsal",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "scripts/demo_rehearsal_api.py"
      ],
      "port": 8000
    },
    {
      "name": "frontend-demo-rehearsal",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_FIREBASE_EMULATORS=true",
        "NEXT_PUBLIC_AQUATRACK_ACCESS=restricted",
        "NEXT_PUBLIC_AQUATRACK_DEMO=1",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    }
  ]
}
