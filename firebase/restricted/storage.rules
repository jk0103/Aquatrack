// GENERATED by scripts/build_restricted_rules.py from firebase/storage.rules. Do not edit.
// Restricted deployment: every rule also requires the custom claim `aquatrack_demo`,
// which the backend sets only on the accounts listed in AQUATRACK_ALLOWED_UIDS.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Swim videos live under videos/{uid}/. Only their owner can upload or watch them.
    match /videos/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.token.aquatrack_demo == true && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.token.aquatrack_demo == true && request.auth.uid == uid
        && request.resource.contentType.matches('video/.*')
        && request.resource.size < 500 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Pose arrays and other analysis artifacts, written by the backend only.
    match /analysis/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.aquatrack_demo == true && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
