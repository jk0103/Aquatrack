rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // True while the backend is deleting this account: nothing new may be written for it.
    function beingDeleted(uid) {
      return exists(/databases/$(database)/documents/account_deletions/$(uid));
    }

    function inRange(value, lo, hi) {
      return value is number && value >= lo && value <= hi;
    }

    // Survey answers, one document per user. Ranges match frontend/app/lib/profile.ts.
    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if false;  // only the backend deletes a profile, with the whole account
      allow create, update: if signedIn() && request.auth.uid == uid
        && !beingDeleted(uid)
        && request.resource.data.keys().hasOnly([
          'age', 'height_cm', 'weight_kg', 'swim_level',
          'sessions_per_week', 'minutes_per_day', 'pbs', 'updatedAt',
          'goals', 'primary_goal', 'target', 'weak_note', 'training'
        ])
        // Training preferences are optional. Values match frontend/app/lib/profile.ts.
        && (request.resource.data.get('training', null) == null
          || (request.resource.data.training.keys().hasOnly([
                'days', 'time_of_day', 'typical_distance_m', 'strokes', 'equipment', 'difficulty'
              ])
            && request.resource.data.training.get('days', []) is list
            && request.resource.data.training.get('days', []).hasOnly(
                 ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
            && request.resource.data.training.get('time_of_day', '') in
                 ['', 'morning', 'midday', 'evening']
            && request.resource.data.training.get('difficulty', '') in
                 ['', 'easy', 'moderate', 'challenging']
            && request.resource.data.training.get('strokes', []) is list
            && request.resource.data.training.get('strokes', []).hasOnly(
                 ['Freestyle', 'Backstroke', 'Breaststroke', 'Butterfly'])
            && request.resource.data.training.get('equipment', []) is list
            && request.resource.data.training.get('equipment', []).hasOnly(
                 ['kickboard', 'pull_buoy', 'fins', 'snorkel'])
            && (request.resource.data.training.get('typical_distance_m', null) == null
              || inRange(request.resource.data.training.typical_distance_m, 100, 10000))))
        // Goals are optional. Values match frontend/app/lib/profile.ts (GOALS).
        && request.resource.data.get('goals', []) is list
        && request.resource.data.get('goals', []).size() <= 7
        && request.resource.data.get('goals', []).hasOnly([
          'stroke_consistency', 'body_alignment', 'arm_technique', 'speed',
          'endurance', 'breathing', 'overall_freestyle'
        ])
        && (request.resource.data.get('primary_goal', null) == null
          || request.resource.data.primary_goal in request.resource.data.get('goals', []))
        && (request.resource.data.get('target', null) == null
          || (request.resource.data.target.keys().hasOnly(['event', 'pool', 'seconds'])
            && request.resource.data.target.event is string
            && inRange(request.resource.data.target.seconds, 10, 3600)))
        && request.resource.data.get('weak_note', '') is string
        && request.resource.data.get('weak_note', '').size() <= 200
        // Personal bests are optional: a list of {event, pool, seconds}, at most 20.
        && request.resource.data.get('pbs', []) is list
        && request.resource.data.get('pbs', []).size() <= 20
        && request.resource.data.age is int && inRange(request.resource.data.age, 5, 100)
        && inRange(request.resource.data.height_cm, 80, 250)
        && inRange(request.resource.data.weight_kg, 15, 250)
        && request.resource.data.swim_level in ['beginner', 'hobby', 'masters', 'competitive']
        && request.resource.data.sessions_per_week is int
        && inRange(request.resource.data.sessions_per_week, 0, 14)
        && request.resource.data.minutes_per_day is int
        && inRange(request.resource.data.minutes_per_day, 0, 600)
        && request.resource.data.updatedAt == request.time;
    }

    // One document per uploaded video. Only the uploader can see it; the file is in Storage.
    match /videos/{videoId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !beingDeleted(request.auth.uid)
        && request.resource.data.status == 'uploaded'
        && request.resource.data.storagePath.matches('videos/' + request.auth.uid + '/.*')
        && request.resource.data.createdAt == request.time;
      // Job state and analysis results are written by the backend, which bypasses these
      // rules. Clients can never change a video's status or forge a result.
      allow update, delete: if false;

      // One document per analysis run: structured results, no per-frame arrays.
      match /analyses/{analysisId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      // Feedback built from one interpretation (explanations, checkpoints, references).
      match /feedback/{feedbackId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      // Still frames chosen for one feedback document's priorities (images in Storage).
      match /frames/{feedbackId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      // Hybrid advice for one analysis: checked AI suggestions and general practice.
      match /advice/{adviceId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      // One document per interpretation of a stored analysis: findings, not measurements.
      match /interpretations/{interpretationId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }
    }

    // Training plans and sessions. Written only by the backend, which checks the owner and
    // validates every edit; the swimmer can read their own and nobody else's.
    match /training_plans/{planId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /training_sessions/{sessionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Backend bookkeeping: the schedule revision counter and the account-deletion marker.
    // No client reads or writes either.
    match /training_state/{uid} {
      allow read, write: if false;
    }
    match /account_deletions/{uid} {
      allow read, write: if false;
    }
  }
}
