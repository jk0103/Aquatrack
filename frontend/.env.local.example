# Copy to frontend/.env.local. Values come from Firebase console > Project settings >
# Your apps > Web app. They identify your project and are safe to ship to the browser,
# but keep .env.local out of git anyway (it's ignored).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to true to use local emulators (npm run emulators) instead of the real project.
NEXT_PUBLIC_FIREBASE_EMULATORS=false
