# Copy to .env and fill in. Never commit .env.
AQUATRACK_UPLOAD_DIR=data/uploads

# Firebase project id (Firebase console > Project settings > General)
FIREBASE_PROJECT_ID=
# Full path to the service account key JSON (Project settings > Service accounts).
# Keep that file outside this folder. Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
# Uncomment to accept logins from the local Firebase emulator instead (npm run emulators)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Used later for personalized feedback text
ANTHROPIC_API_KEY=
