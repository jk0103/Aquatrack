# Copy to .env and fill in. Never commit .env.
AQUATRACK_UPLOAD_DIR=data/uploads
DATABASE_URL=sqlite:///data/aquatrack.db

# Signs login cookies. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AQUATRACK_SECRET_KEY=
# Set to true when the app is served over HTTPS
AQUATRACK_COOKIE_SECURE=false

# Used later for personalized feedback text
ANTHROPIC_API_KEY=
