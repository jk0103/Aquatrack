# Copy to .env and fill in. Never commit .env.

# --- Which environment this process is in: emulator (default) | test | staging | production ---
# staging and production are for a future deployment. Locally this must stay "emulator": the
# API and the worker refuse to start against a real Firebase project otherwise, and refuse
# service-account credentials or a non-demo project id in a local environment.
AQUATRACK_ENV=emulator

# --- Restricted access and the school demonstration (docs/SCHOOL_DEMO_DEPLOYMENT.md) ---
# AQUATRACK_ACCESS=restricted     # only the uids below may use the API (default: open)
# AQUATRACK_ALLOWED_UIDS=         # Firebase uids, comma separated
# AQUATRACK_DEMO=1                # staging only, with restricted access: analyse the approved
#                                 # test video from saved pose data. Never in production.

# --- Who runs analysis jobs: embedded (default, a thread inside the API) | external ---
# external: the API only queues; start workers with `uv run python -m aquatrack.worker`.
# AQUATRACK_WORKER=embedded
# AQUATRACK_JOB_LEASE_S=120          # a worker must renew within this, or the job is recovered
# AQUATRACK_JOB_TIMEOUT_S=3600       # longest one run may take
# AQUATRACK_MAX_ACTIVE_JOBS=2        # queued or running per swimmer
# AQUATRACK_MAX_VIDEO_SECONDS=180    # checked on the file itself

# --- Local development: Firebase Emulator Suite (sh scripts/emulators.sh) ---
# The API refuses to start its Firebase store unless both emulator hosts below are set.
FIREBASE_PROJECT_ID=demo-aquatrack
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

# --- Pose data source: precomputed (default) | local | remote ---
# precomputed: pose files made in Colab, named <video sha256>.rawpose.npz
AQUATRACK_POSE_SOURCE=precomputed
AQUATRACK_PRECOMPUTED_POSE_DIR=data/precomputed_pose
# local: real inference. Needs `uv sync --extra pose` and the model files with their
# manifest.json in AQUATRACK_MODELS_DIR (default models/). For a worker image, not for this
# Mac: see docs/INFERENCE_WORKER.md.
# AQUATRACK_POSE_DEVICE=cpu          # cpu | cuda | mps
# AQUATRACK_MODELS_STRICT=1          # refuse model files that are not in the manifest
# AQUATRACK_WORKER_MAX_RSS_MB=0      # fail a job whose process outgrows this (0 = off)
# AQUATRACK_TMP_DIR=                 # where a job's working files go (removed per job)
# AQUATRACK_MODELS_DIR=models
# Model overrides (defaults: yolo11m.pt, 640, 0.15, tracking, rtmw_x_stock.onnx)
# AQUATRACK_DETECTOR_WEIGHTS=yolo11m.pt
# AQUATRACK_DETECTOR_IMGSZ=640
# AQUATRACK_DETECTOR_CONFIDENCE=0.15

# Analysis attempts allowed per video (default 3). Raise it in development, where a video
# fails until its pose file has been added.
# AQUATRACK_MAX_ATTEMPTS=10

# --- Not used yet ---
# Production Firebase is not connected. When it is: a service account key path kept
# outside this folder, plus AQUATRACK_ALLOW_PRODUCTION_FIREBASE=1.
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Optional: reword feedback and training plans with an OpenAI model ---
# Off by default; the app is complete without it. When on, each analysed video and each saved
# plan makes one billed API call. Needs `uv sync --extra llm`, the provider line below AND a
# key. Put the key only in your own untracked .env (or your shell); never in git, never in
# the frontend, never in a chat.
# AQUATRACK_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# AQUATRACK_LLM_MODEL=gpt-6-luna
# AQUATRACK_LLM_TIMEOUT_S=20
# AQUATRACK_LLM_MAX_OUTPUT_TOKENS=4000
# AQUATRACK_LLM_MAX_CALLS_PER_DAY=200   # ceiling on billed calls per API process per day
# Live-test procedure and cost estimate: docs/OPENAI_LIVE_TEST.md
